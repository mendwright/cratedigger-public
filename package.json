{
  "name": "cratedigger",
  "version": "1.21.0",
  "description": "Desktop Plex music client with album-flip UX, credit browsing, and casting to headless Plexamp",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "PUBLIC_BUILD=1 electron-vite dev",
    "build": "PUBLIC_BUILD=1 electron-vite build",
    "start": "PUBLIC_BUILD=1 electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && svelte-check --tsconfig tsconfig.web.json",
    "test": "vitest run",
    "dist": "PUBLIC_BUILD=1 electron-vite build && electron-builder --mac",
    "classical:seed": "node scripts/fetch-openopus-seed.mjs"
  },
  "build": {
    "appId": "com.mendwright.cratedigger",
    "productName": "Cratedigger",
    "protocols": [
      {
        "name": "Cratedigger",
        "schemes": [
          "cratedigger"
        ]
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!node_modules/**/bin/darwin-*-*/**"
    ],
    "extraResources": [
      {
        "from": "resources/classical",
        "to": "classical",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asarUnpack": [
      "**/*.node",
      "node_modules/@arcanewizards/electron-media-service/**/*",
      "node_modules/better-sqlite3/**/*"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.music",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true
    },
    "dmg": {
      "writeUpdateInfo": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "mendwright",
        "repo": "cratedigger-public"
      }
    ]
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@tsconfig/svelte": "^5.0.4",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.9.0",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.7",
    "electron-vite": "^2.3.0",
    "node-gyp": "^12.3.0",
    "svelte": "^5.1.9",
    "svelte-check": "^4.0.5",
    "tslib": "^2.8.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "@arcanewizards/electron-media-service": "^0.3.2",
    "better-sqlite3": "^12.11.1",
    "electron-store": "^10.0.0",
    "electron-updater": "^6.8.3"
  }
}
